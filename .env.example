# Supabase → Connect → Transaction pooler URI (port 6543). Supabase는 Free 플랜으로 DB만 쓴다(영상은 Vercel Blob).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 선택: 서버 인스턴스 하나가 pooler에 여는 연결 수 상한(양의 정수, 기본 5). Supabase Free의 transaction pooler는 클라이언트를
# 200개까지 받으므로 인스턴스 수 × DB_POOL_MAX ≤ 100으로 둔다. 계산은 docs/notes/db-pool-diagnosis.md.
DB_POOL_MAX=

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (바꾸면 저장된 API 키를 복호화할 수 없음)
AUTH_SECRET=

# npm run db:seed 가 만드는 첫 관리자
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 선택: 공개(public) Vercel Blob 스토어의 토큰. 있으면 완료 영상을 videos/<생성 id>.mp4로 복사해 Higgsfield가 7일 뒤
# 지운 뒤에도 재생하고, 4 MB 초과 레퍼런스 업로드도 받는다. 비우면 복사하지 않고 Higgsfield URL로 재생한다.
# vercel blob create-store <이름> --access public --yes 가 프로젝트에 넣어 주고, 로컬은 vercel env pull 로 받는다.
BLOB_READ_WRITE_TOKEN=

# 선택: 가짜 서버(npm run fake:hf)의 Blob API로 복사까지 돌릴 때만 http://localhost:4010/api/blob 과
# http://localhost:4010/blob 을 넣고, 토큰은 vercel_blob_rw_fake_fake 처럼 vercel_blob_rw_<id>_<secret> 모양이면 된다.
# 실제 스토어에서는 둘 다 비워 둔다. 공개 주소는 토큰의 store id로 https://<store id>.public.blob.vercel-storage.com 이다.
VERCEL_BLOB_API_URL=
BLOB_PUBLIC_BASE_URL=
# 테스트 전용: 브라우저의 4 MB 초과 레퍼런스 업로드까지 가짜 서버로 보낼 때만 켠다. NEXT_PUBLIC_이라 next build 때 클라이언트
# 번들에 박히므로 값을 바꾸면 다시 빌드해야 하고, 실제 배포에서는 절대 넣지 않는다.
# NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:4010/api/blob

# 선택: 이미지 생성(GPT Image 2)에 팀 전체가 같이 쓰는 OpenAI API 키. 서버만 읽고 브라우저나 로그로는 나가지 않는다.
# 비우면 플레이그라운드에서 GPT Image 2가 "사용 불가"로 꺼지고 서버는 이미지 요청을 503으로 거절한다. 이미지 결과는 Blob에만
# 남으므로 BLOB_READ_WRITE_TOKEN도 있어야 한다. Vercel에서는 Production 환경 변수로 넣고, 바꾼 값은 다음 배포부터 적용된다.
OPENAI_API_KEY=

# 선택: OpenAI API 주소. 비우면 https://api.openai.com/v1. 가짜 서버(npm run fake:hf)로 돌릴 때만
# http://localhost:4010/openai/v1 을 넣고, 이때 OPENAI_API_KEY는 sk-fake 같은 아무 값이면 된다.
OPENAI_BASE_URL=

# 선택: Higgsfield API 주소. 비우면 https://api.higgsfield.ai.
# 로컬에서 `npm run fake:hf`로 띄운 가짜 서버를 쓰려면 http://localhost:4010. 이때 크론 라우트는 공용 DB를 sweep하지 않고
# 409를 돌려준다(아래 SWEEP_ALLOW_NONPROD).
HIGGSFIELD_BASE_URL=

# 선택: 1이면 HIGGSFIELD_BASE_URL이 실제 Higgsfield가 아니어도 크론 라우트가 sweep한다. sweep은 공용 DB의 모든 사용자의
# due 행을 처리하므로, 가짜 서버로 돌릴 때는 DB의 due 행이 모두 이 실행의 것일 때만 켠다. 프로덕션에서는 비워 둔다.
SWEEP_ALLOW_NONPROD=

# 선택: Higgsfield 웹훅이 부를 이 앱의 공개 주소. 비우면 Vercel의 프로덕션 도메인(VERCEL_PROJECT_PRODUCTION_URL)을 쓰고,
# 둘 다 없으면(로컬) 웹훅 없이 브라우저 폴링만 쓴다. 가짜 서버의 웹훅을 로컬에서 받으려면 http://localhost:3000
PUBLIC_BASE_URL=

# Vercel Cron이 /api/cron/settle에 Authorization: Bearer <값>으로 보낸다. 비어 있으면 크론 라우트는 항상 401.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
